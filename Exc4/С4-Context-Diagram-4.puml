@startuml
!include <C4/C4_Context>

title Диаграмма контекста "Передача актуальных ставок"

Person(BackOfficeManager, "Сотрудник бэк-офиса", "Обновляет / редактирует ставки в Excel")
Person(BankCallCenterOperator, "Оператор кол-центра (банк)", "Просматривает ставки и консультирует клиентов")
Person(PartnerCCOperator, "Оператор партнёрского кол-центра", "Получает выгруженные файлы ставок")

System(ABS, "АБС (Core Banking System)", "Система учёта банка")
System(CallCenterSystem, "Система кол-центра", "Позволяет операторам видеть актуальные ставки")
System(RateExporter, "Rate Exporter", "Модуль (скрипт/сервис) для выгрузки ставок во внешнюю систему")
System(BackOfficeExcel, "Excel (бэк-офис)", "Файл / набор Excel-шаблонов для расчёта ставок")
System_Ext(PartnerCallCenter, "Партнёрский кол-центр", "Внешняя система для обслуживания клиентов")

Rel(BackOfficeManager, BackOfficeExcel, "Редактирует / обновляет ставки вручную")
Rel(BackOfficeExcel, ABS, "Загружает обновлённые ставки")
Rel(BankCallCenterOperator, CallCenterSystem, "Просматривает и озвучивает клиентам ставки")
Rel(CallCenterSystem, ABS, "Получает актуальные ставки")
Rel(ABS, RateExporter, "Предоставляет данные ставок (SELECT / API)")
Rel(RateExporter, PartnerCallCenter, "Выгружает файл (XLS/CSV) SFTP")

@enduml
